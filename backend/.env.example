PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/shopledger

# JWT Auth
JWT_SECRET=super_secret_jwt_key_shopledger_change_in_production_2026
JWT_EXPIRES_IN=7d

# Cloudinary (Optional for dev, uploads fallback gracefully if not configured)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# WhatsApp Business Cloud API (Official Meta API)
# Get these from developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_or_system_user_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_VERIFY_TOKEN=shopledger_webhook_secret_verify_token_2026

# Shop Details
DEFAULT_SHOP_NAME=ShopLedger Mart
DEFAULT_SHOP_PHONE=+919876543210
DEFAULT_CURRENCY=₹

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
